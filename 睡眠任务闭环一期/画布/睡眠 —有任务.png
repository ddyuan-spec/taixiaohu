</main>
<script>
  function copyUrl(btn) {
    const u = btn.getAttribute('data-url');
    navigator.clipboard.writeText(u).then(() => {
      btn.textContent = '已复制'; btn.classList.add('done');
      setTimeout(() => { btn.textContent = '复制链接'; btn.classList.remove('done'); }, 1500);
    });
  }
</script>
</body>
